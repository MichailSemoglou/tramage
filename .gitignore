papers/

# Experiment corpora (large, redistributable; fetched on demand)
experiments/corpora/
# Experiment outputs: result CSVs are tracked as the data of record;
# transient artifacts (backups, logs, rendered figures, diagnostics) are not.
experiments/*/results/*.bak
experiments/*/results/*.log
experiments/*/results/*.png
experiments/*/results/diagnostics/

# Raw CQ100 download (data, not code)
/CQ100 A High-Quality*/

# Submission-side renamed copies; the canonical repo artifacts are the
# script outputs (figures/summary_image.png is regenerated by
# figures/summary_image.py).
figures/EI2027_HVEI_MS_*

# Figure generator scripts stay local; the repo ships the two PNGs only.
figures/summary_image.py
figures/proposal_figure.py

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out

# IS&T author kit (third-party assets, local build tree): the repo ships
# only the submitted PDF, not the kit or the LaTeX source.
abstract/IS&T_Submission_Latex_Template/*
!abstract/IS&T_Submission_Latex_Template/EI2027_HVEI_MS_submission.pdf

# Internal long-form abstract (the repo ships the submitted PDF instead)
abstract/ABSTRACT.md

# Prototype demo outputs (regenerated by running the scripts)
prototypes/out/
